---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Plans from '../components/landing/Plans.astro';
import Foundry from '../components/landing/Foundry.astro';
import Referrals from '../components/landing/Referrals.astro';
import Roulette from '../components/landing/Roulette.astro';
import Withdrawals from '../components/landing/Withdrawals.astro';
---
<LandingLayout>
  <Hero />
  <HowItWorks />
  <Plans />
  <Foundry />
  <Referrals />
  <Roulette />
  <Withdrawals />
  <footer class="footer">
    <div class="section-inner text-center">
      <p class="caption">GOLD MINING — Infraestructura digital de minería</p>
    </div>
  </footer>
</LandingLayout>
<style>
  .footer { padding: var(--space-2xl) var(--space-md); border-top: 1px solid var(--gold-line); position: relative; z-index: var(--z-content); }
</style>
