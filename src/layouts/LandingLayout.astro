---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Gold Mining — Infraestructura digital de minería del futuro',
  description = 'Invierte en minería de oro y haz crecer tu capital. Planes desde $25.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0805" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style define:vars={{ tunnelBg: `url(${base}images/tunnel-bg.jpg)` }}>
    .tunnel-bg { --tunnel-bg: var(--tunnelBg); }
  </style>
</head>
<body>
  <div class="tunnel-bg" aria-hidden="true"></div>
  <div class="tunnel-vignette" aria-hidden="true"></div>
  <canvas id="particles" aria-hidden="true"></canvas>
  <main><slot /></main>
  <script>
    import { initMotion } from '../lib/motion';
    initMotion();
  </script>
</body>
</html>
