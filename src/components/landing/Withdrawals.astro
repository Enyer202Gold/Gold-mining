---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { withdrawals } from '../../content/business';
---
<section class="section" id="retiros" aria-label="Retiros">
  <div class="section-inner">
    <h2 class="section-title text-center" data-reveal>{withdrawals.title}</h2>
    <div class="section-divider" data-divider></div>
    <p class="text-dim" data-reveal style="margin-bottom: 24px;">{withdrawals.intro}</p>
    <div data-reveal>
      <Card float>
        <div class="flow" aria-label="Flujo de retiro">
          {withdrawals.flow.map((step, i) => (
            <><span class="flow-node">{step}</span>{i < withdrawals.flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}</>
          ))}
        </div>
      </Card>
    </div>
    <div data-reveal>
      <Card tag="CONDICIONES">
        <dl class="details">
          {withdrawals.details.map((d) => (
            <div class="detail-row"><dt class="text-dim">{d.label}</dt><dd class="num">{d.value}</dd></div>
          ))}
        </dl>
      </Card>
    </div>
    <div data-reveal>
      <Card tag="EJEMPLO">
        <p class="text-dim">{withdrawals.example.text}</p>
        <p class="example-result">Recibes <span class="num text-gold">$44 USDT</span></p>
        <div style="margin-top: 16px;"><Button variant="primary" href="#hero">Empezar ahora</Button></div>
      </Card>
    </div>
  </div>
</section>
<style>
  .flow { display: flex; align-items: center; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; }
  .flow-node { background: var(--bg-glass); border: 1px solid var(--gold-line); border-radius: var(--radius-pill); padding: 8px 14px; font-size: 13px; font-weight: 500; text-align: center; }
  .flow-arrow { color: var(--gold); }
  .details { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-sm); }
  .detail-row { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; }
  .example-result { font-size: 18px; margin-top: 8px; }
  .example-result .num { font-size: 24px; font-weight: 600; }
  .section-inner > div { margin-bottom: var(--space-lg); }
  .section-inner .btn { width: 100%; }
</style>
