---
import Button from '../ui/Button.astro';
import HUD from '../ui/HUD.astro';
import { hero } from '../../content/business';
---
<section class="hero" id="hero" aria-label="Presentación">
  <div class="hero-inner">
    <div class="hero-badge" data-reveal><HUD label={hero.badge} /></div>
    <h1 class="hero-title font-display" data-reveal>
      <span class="hero-line">{hero.titleLine1}</span>
      <span class="hero-line">{hero.titleLine2}</span>
    </h1>
    <p class="hero-subtitle" data-reveal>{hero.subtitle}</p>
    <p class="hero-desc text-dim" data-reveal>{hero.description}</p>
    <div class="hero-ctas" data-reveal>
      <Button variant="primary" href="#planes">{hero.ctaPrimary}</Button>
      <Button variant="secondary" href="#retiros">{hero.ctaSecondary}</Button>
    </div>
    <a href="#func" class="hero-more btn-tertiary">{hero.ctaTertiary} ↓</a>
  </div>
</section>
<style>
  .hero { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; justify-content: center; text-align: center; padding: var(--space-3xl) var(--space-md); position: relative; }
  .hero-inner { max-width: 480px; display: flex; flex-direction: column; align-items: center; gap: var(--space-md); }
  .hero-title { font-size: clamp(48px, 15vw, 96px); letter-spacing: 0.04em; line-height: 1.05; color: var(--gold-light); text-shadow: 0 2px 30px rgba(0,0,0,0.6); }
  .hero-line { display: block; }
  .hero-subtitle { font-size: 20px; font-weight: 500; color: var(--text); }
  .hero-desc { font-size: 16px; max-width: 320px; }
  .hero-ctas { display: flex; flex-direction: column; gap: var(--space-sm); width: 100%; max-width: 320px; margin-top: var(--space-md); }
  .hero-ctas :global(.btn-secondary) {
    background: rgba(10, 8, 5, 0.65); /* pastilla oscura: contraste sobre el túnel brillante */
    border-color: var(--gold);
    color: var(--gold-light);
  }
  .hero-more { margin-top: var(--space-lg); font-size: 14px; }
</style>
