---
import Card from '../ui/Card.astro';
import { howItWorks } from '../../content/business';
---
<section class="section" id="func" aria-label="Cómo funciona">
  <div class="section-inner">
    <h2 class="section-title text-center" data-reveal>{howItWorks.title}</h2>
    <div class="section-divider" data-divider></div>
    <ol class="steps">
      {howItWorks.steps.map((step) => (
        <li data-reveal>
          <Card>
            <span class="step-num num">{step.n}</span>
            <h3>{step.title}</h3>
            <p class="text-dim">{step.desc}</p>
          </Card>
        </li>
      ))}
    </ol>
    <div data-reveal>
      <Card tag="EJEMPLO" float>
        <h3>{howItWorks.example.title}</h3>
        <dl class="example-grid">
          <div><dt class="caption">Máquina</dt><dd class="num">{howItWorks.example.machine}</dd></div>
          <div><dt class="caption">Capital</dt><dd class="num">{howItWorks.example.capital}</dd></div>
          <div><dt class="caption">Genera</dt><dd class="num text-gold">{howItWorks.example.daily}</dd></div>
        </dl>
      </Card>
    </div>
  </div>
</section>
<style>
  .steps { list-style: none; display: flex; flex-direction: column; gap: var(--space-md); margin: var(--space-xl) 0; }
  .step-num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--gold); color: #0A0805; font-weight: 600; font-size: 16px; margin-bottom: var(--space-sm); }
  .steps h3 { font-size: 17px; margin-bottom: 4px; }
  .steps p { font-size: 14px; }
  .example-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-top: var(--space-md); }
  .example-grid dd { font-size: 18px; margin-top: 4px; }
</style>
