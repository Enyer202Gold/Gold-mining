---
import Card from '../ui/Card.astro';
import { foundry } from '../../content/business';
import { formatEnergy } from '../../lib/format';
---
<section class="section" id="fundidora" aria-label="Fundidora">
  <div class="section-inner">
    <h2 class="section-title text-center" data-reveal>{foundry.title}</h2>
    <div class="section-divider" data-divider></div>
    <div data-reveal>
      <Card float>
        <p class="foundry-intro">{foundry.intro}</p>
        <p class="foundry-warning text-gold">{foundry.warning}</p>
        <div class="flow" aria-label="Flujo del proceso">
          {foundry.flow.map((step, i) => (
            <><span class="flow-node">{step}</span>{i < foundry.flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}</>
          ))}
        </div>
      </Card>
    </div>
    <div data-reveal>
      <Card tag="FUNDICIÓN ACTIVA">
        <h3>{foundry.unlockTitle}</h3>
        <ol class="unlock-steps">
          {foundry.unlockSteps.map((s) => (
            <li>{s.text} <strong class="text-gold">{s.highlight}</strong> {s.suffix}</li>
          ))}
        </ol>
      </Card>
    </div>
    <div data-reveal>
      <Card tag="COSTO DE FUNDICIÓN">
        <div class="energy-list">
          {foundry.energyCosts.map((e) => (
            <div class="energy-row"><span>{e.material}</span><span class="num text-gold">{formatEnergy(e.cost)}</span></div>
          ))}
        </div>
        <p class="caption" style="margin-top: 8px;">{foundry.energyNote}</p>
        <div class="energy-bonus">
          {foundry.energyBonus.map((b) => (
            <p><span class="num text-gold">+{b.amount} ⚡</span><span class="text-dim"> {b.desc}</span></p>
          ))}
        </div>
      </Card>
    </div>
  </div>
</section>
<style>
  .foundry-intro { font-size: 16px; margin-bottom: var(--space-sm); }
  .foundry-warning { font-weight: 600; margin-bottom: var(--space-lg); }
  .flow { display: flex; align-items: center; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; margin: var(--space-md) 0; }
  .flow-node { background: var(--bg-glass); border: 1px solid var(--gold-line); border-radius: var(--radius-pill); padding: 8px 16px; font-size: 14px; font-weight: 500; }
  .flow-arrow { color: var(--gold); }
  .unlock-steps { margin-top: var(--space-md); padding-left: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); font-size: 15px; }
  .energy-list { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-md); }
  .energy-row { display: flex; justify-content: space-between; font-size: 15px; }
  .energy-bonus { margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--gold-line); display: flex; flex-direction: column; gap: var(--space-sm); font-size: 14px; }
  .section-inner > div { margin-bottom: var(--space-lg); }
</style>
