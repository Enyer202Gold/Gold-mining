---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { roulette } from '../../content/business';
---
<section class="section" id="ruleta" aria-label="Ruleta">
  <div class="section-inner text-center">
    <h2 class="section-title" data-reveal>{roulette.title}</h2>
    <div class="section-divider" data-divider></div>
    <div data-reveal>
      <Card float>
        <p class="text-dim" style="margin-bottom: 16px;">{roulette.intro}</p>
        <div class="wheel-placeholder" role="img" aria-label="Ruleta de premios"><span aria-hidden="true">🎡</span></div>
        <p class="spins">{roulette.spinsLabel}<span class="num text-gold" id="spincount">3</span></p>
        <Button variant="primary" id="spinbtn">{roulette.cta}</Button>
        <p class="caption" style="margin-top: 12px;">Conecta tu cuenta para girar</p>
      </Card>
    </div>
  </div>
</section>
<style>
  .wheel-placeholder { font-size: 64px; margin: var(--space-lg) 0; display: flex; justify-content: center; }
  .spins { font-size: 16px; margin-bottom: var(--space-md); }
  .spins .num { font-size: 24px; font-weight: 600; margin-left: 8px; }
</style>
<script>
  const btn = document.getElementById('spinbtn');
  btn?.addEventListener('click', () => {
    if (btn instanceof HTMLButtonElement) {
      btn.textContent = 'Próximamente';
      btn.disabled = true;
      btn.style.opacity = '0.5';
    }
  });
</script>
