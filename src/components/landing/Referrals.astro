---
import Card from '../ui/Card.astro';
import { referrals } from '../../content/business';
---
<section class="section" id="referidos" aria-label="Referidos">
  <div class="section-inner">
    <h2 class="section-title text-center" data-reveal>{referrals.title}</h2>
    <div class="section-divider" data-divider></div>
    <p class="text-center text-dim" data-reveal style="margin-bottom: 24px;">{referrals.intro}</p>
    <div class="levels">
      {referrals.levels.map((level) => (
        <div data-reveal>
          <Card tag={`NIVEL ${level.n}`} float>
            <p class="level-pct num text-gold">{level.pct}%</p>
            <p class="text-dim">{level.desc}</p>
          </Card>
        </div>
      ))}
    </div>
    <div data-reveal>
      <Card tag="EJEMPLOS">
        {referrals.examples.map((ex) => (
          <p class="example-row"><span class="text-dim">{ex.text}</span><span class="num text-gold example-amount">{ex.amount}</span></p>
        ))}
      </Card>
    </div>
  </div>
</section>
<style>
  .levels { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .level-pct { font-size: 40px; font-weight: 600; margin-bottom: 4px; }
  .example-row { display: flex; flex-direction: column; gap: 4px; padding: var(--space-sm) 0; font-size: 14px; }
  .example-row + .example-row { border-top: 1px solid var(--gold-line); }
  .example-amount { font-size: 20px; font-weight: 600; }
</style>
