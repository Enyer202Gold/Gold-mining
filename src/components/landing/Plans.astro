---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Meter from '../ui/Meter.astro';
import { plans } from '../../content/business';
import { formatUSD, formatPct, formatUSDT } from '../../lib/format';
---
<section class="section" id="planes" aria-label="Planes de minería">
  <div class="section-inner">
    <h2 class="section-title text-center" data-reveal>PLANES DE MINERÍA</h2>
    <div class="section-divider" data-divider></div>
    <div class="plans-grid">
      {plans.map((plan) => (
        <div data-reveal>
          <Card tag={plan.tag}>
            <div class="plan-img-wrap">
              <img src={plan.image} alt={`Máquina ${plan.name}`} loading="lazy" width="400" height="300" />
            </div>
            <h3 class="plan-name">{plan.name}</h3>
            <dl class="plan-details">
              <div class="plan-row"><dt>Compras la máquina</dt><dd class="num">{formatUSD(plan.machinePrice)} USD</dd></div>
              <div class="plan-row"><dt>Capital en tu wallet</dt><dd class="num">{plan.capitalLabel}</dd></div>
              <div class="plan-row"><dt>Generas diario</dt><dd class="num text-gold">{formatPct(plan.dailyPct)}</dd></div>
            </dl>
            <Meter value={plan.dailyPct * 10} label="Rendimiento diario" />
            <p class="plan-example text-dim">
              Con <span class="num">{formatUSDT(plan.exampleCapital)}</span> generas
              <span class="num text-gold"> ${formatUSDT(plan.exampleDaily)} al día</span>
            </p>
            <Button variant="primary" href="#retiros">Activar plan</Button>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .plans-grid { display: flex; flex-direction: column; gap: var(--space-lg); margin-top: var(--space-xl); }
  .plan-img-wrap { border-radius: var(--radius-card); overflow: hidden; margin-bottom: var(--space-md); aspect-ratio: 4 / 3; background: var(--bg-mine); }
  .plan-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .plan-name { font-size: 20px; margin-bottom: var(--space-md); }
  .plan-details { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .plan-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-sm); }
  .plan-row dt { font-size: 14px; color: var(--text-dim); }
  .plan-row dd { font-size: 16px; font-weight: 500; }
  .plan-example { font-size: 14px; margin: var(--space-md) 0; }
  .plans-grid .btn { width: 100%; }
  @media (min-width: 768px) { .plans-grid { display: grid; grid-template-columns: repeat(2, 1fr); } }
</style>
