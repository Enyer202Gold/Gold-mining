---
interface Props { value: number; label?: string; id?: string; }
const { value, label, id } = Astro.props;
---
<div class="meter-wrap">
  {label && <span class="caption">{label}</span>}
  <div class="meter" role="progressbar" aria-valuenow={value} aria-valuemin={0} aria-valuemax={100} aria-label={label || 'Medidor'} id={id}>
    <div class="meter-fill" data-meter-value={value}></div>
  </div>
</div>
<style>.meter-wrap { display: flex; flex-direction: column; gap: 6px; }</style>
